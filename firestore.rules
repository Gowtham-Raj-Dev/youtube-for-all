rules_version = '2';

// - users/{uid} (+ items): each user reads and writes only their own; the admin can read everyone's.
// - presence/{uid}: who is online (name, photo, channel title only); every signed-in user can read it.
// - members/{uid}, channels/{uid}: public creator count and channel directory (anyone may read).
// Nothing else in the database is reachable from the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'codelove.in@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.size() < 40;

      // Uploaded / queued / scheduled videos.
      match /items/{itemId} {
        allow read: if isOwner(uid) || isAdmin();
        allow delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.kind in ['video', 'short']
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 5000;
      }
    }

    // Admin dashboard: every user's videos in one collection-group query.
    match /{path=**}/items/{itemId} {
      allow read: if isAdmin();
    }

    // Public: one empty-ish doc per creator, so the home page can show how many there are.
    match /members/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['joinedAt'])
        && request.resource.data.joinedAt is timestamp;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Public channel directory (/channels): what any visitor of the channel on YouTube already sees.
    match /channels/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['id', 'title', 'handle', 'thumbnail', 'subscribers', 'videos', 'updatedAt'])
        && request.resource.data.id is string && request.resource.data.id.size() <= 64
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.handle is string && request.resource.data.handle.size() <= 100
        && request.resource.data.thumbnail is string && request.resource.data.thumbnail.size() <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /presence/{uid} {
      allow read: if signedIn();
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'photo', 'channel', 'lastSeen'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.lastSeen == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
