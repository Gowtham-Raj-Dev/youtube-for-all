# Copy to .env.local and fill in your Firebase web app config (Project settings → Your apps).
# In CI these come from GitHub Actions secrets with the same names.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: where the 'Cut with VideoCut' popup loads from (default https://videocut.codelove.in).
# For local testing of both apps: VITE_VIDEOCUT_URL=http://localhost:3001
VITE_VIDEOCUT_URL=
