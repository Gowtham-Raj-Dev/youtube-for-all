rules_version = '2';

// Each signed-in user can only read and write their own documents.
// Nothing else in the database is reachable from the browser.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && request.resource.size() < 40;

      // Uploaded / queued / scheduled videos.
      match /items/{itemId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.kind in ['video', 'short']
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 100
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 5000;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
